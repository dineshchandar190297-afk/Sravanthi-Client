<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:padding="20dp">

    <!-- Top Navigation Bar -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_revert"
        android:contentDescription="Back"
        android:tint="@color/colorText"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvGameTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Brush Master 🪥"
        android:textColor="@color/colorPrimaryDark"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        android:layout_marginStart="12dp" />

    <!-- Timer and Score info -->
    <TextView
        android:id="@+id/tvTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Time: 30s"
        android:textColor="@color/colorText"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintEnd_toEndOf="parent" />

    <ProgressBar
        android:id="@+id/pbCleaned"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:layout_marginTop="16dp"
        android:progress="0"
        android:max="12"
        android:progressTint="@color/green"
        android:progressBackgroundTint="@color/grey"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Game Instruction -->
    <TextView
        android:id="@+id/tvInstruction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Drag your finger over the dirty spots to brush them!"
        android:textColor="@color/colorTextHint"
        android:textSize="14sp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/pbCleaned"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Game Board (Mouth / Tooth container) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/gameBoard"
        android:layout_width="320dp"
        android:layout_height="320dp"
        app:cardCornerRadius="160dp"
        app:cardBackgroundColor="@color/white"
        app:cardElevation="4dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvInstruction"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="48dp">

        <!-- A RelativeLayout containing 12 dirty spots -->
        <RelativeLayout
            android:id="@+id/rlGameArea"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Center Tooth Visual represented by a white card/circle -->
            <View
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_centerInParent="true"
                android:background="@android:drawable/presence_online"
                android:backgroundTint="@color/colorCardChild"
                android:alpha="0.8" />

            <!-- 12 Dirty spots scattered in relative positions -->
            <View
                android:id="@+id/spot1"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginLeft="140dp"
                android:layout_marginTop="60dp"
                android:background="@drawable/dirt_spot" />

            <View
                android:id="@+id/spot2"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginLeft="90dp"
                android:layout_marginTop="90dp"
                android:background="@drawable/dirt_spot" />

            <View
                android:id="@+id/spot3"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginLeft="190dp"
                android:layout_marginTop="90dp"
                android:background="@drawable/dirt_spot" />

            <View
                android:id="@+id/spot4"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginLeft="60dp"
                android:layout_marginTop="140dp"
                android:background="@drawable/dirt_spot" />

            <View
                android:id="@+id/spot5"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginLeft="220dp"
                android:layout_marginTop="140dp"
                android:background="@drawable/dirt_spot" />

            <View
                android:id="@+id/spot6"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginLeft="90dp"
                android:layout_marginTop="190dp"
                android:background="@drawable/dirt_spot" />

            <View
                android:id="@+id/spot7"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginLeft="190dp"
                android:layout_marginTop="190dp"
                android:background="@drawable/dirt_spot" />

            <View
                android:id="@+id/spot8"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginLeft="140dp"
                android:layout_marginTop="220dp"
                android:background="@drawable/dirt_spot" />

            <View
                android:id="@+id/spot9"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginLeft="142dp"
                android:layout_marginTop="110dp"
                android:background="@drawable/dirt_spot"
                android:backgroundTint="#FFD54F" /> <!-- Golden sugar bug -->

            <View
                android:id="@+id/spot10"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginLeft="142dp"
                android:layout_marginTop="170dp"
                android:background="@drawable/dirt_spot"
                android:backgroundTint="#FFD54F" /> <!-- Golden sugar bug -->

            <View
                android:id="@+id/spot11"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginLeft="100dp"
                android:layout_marginTop="140dp"
                android:background="@drawable/dirt_spot" />

            <View
                android:id="@+id/spot12"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginLeft="180dp"
                android:layout_marginTop="140dp"
                android:background="@drawable/dirt_spot" />
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
